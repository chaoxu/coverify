+// --- coverify patch: mid-stream retry (see patches/ and coverify docs) ---
+// The request phase already retries, but a transport death during
+// processStream (socket reset mid-reasoning) was always fatal. Codex's own
+// CLI retries these with backoff (stream_max_retries); this patch gives the
+// SSE path the same resilience. Bounded, transport-errors only, in-place
+// output reset so the single started message stays coherent for consumers.
+const COVERIFY_MIDSTREAM_RETRIES = (() => {
+    const n = Number(globalThis.process?.env?.PI_CODEX_MIDSTREAM_RETRIES ?? 2);
+    return Number.isFinite(n) && n >= 0 ? n : 2;
+})();
+function coverifyIsMidStreamTransportError(error) {
+    const msg = String(error?.message ?? error ?? "");
+    if (/usage limit|quota|billing/i.test(msg)) return false;
+    return /socket|network|terminated|connection|closed|reset|EPIPE|ECONNRESET|fetch failed|timed? out/i.test(msg);
+}
+function coverifyResetOutputForRetry(output) {
+    output.content.length = 0;
+    output.usage.input = 0;
+    output.usage.output = 0;
+    output.usage.cacheRead = 0;
+    output.usage.cacheWrite = 0;
+    delete output.stopReason;
+    delete output.errorMessage;
+}
+// --- end coverify patch helpers ---
