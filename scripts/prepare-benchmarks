#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any
from urllib.request import urlretrieve


ROOT = Path(__file__).resolve().parents[1]
DATASETS = ROOT / ".autoprover" / "benchmarks" / "datasets"
CACHE = ROOT / ".autoprover" / "benchmarks" / "cache"
OPC_SPLITS = ["best_of_n", "generic", "matharena", "pass_at_n", "putnambench", "test"]


def ensure_parquet_reader() -> None:
    try:
        import pyarrow.parquet  # noqa: F401
        return
    except ImportError:
        pass
    if os.environ.get("AUTOPROVER_PREPARE_WITH_UV") == "1":
        raise SystemExit("pyarrow is required to prepare OPC parquet files")
    if shutil.which("uv") is None:
        raise SystemExit("pyarrow is required to prepare OPC parquet files; install pyarrow or uv")
    env = os.environ.copy()
    env["AUTOPROVER_PREPARE_WITH_UV"] = "1"
    os.execvpe(
        "uv",
        ["uv", "run", "--no-project", "--with", "pyarrow", "python", *sys.argv],
        env,
    )


def clone_or_update(url: str, path: Path) -> None:
    if path.exists():
        subprocess.run(["git", "-C", str(path), "fetch", "--depth", "1", "origin"], check=True)
        subprocess.run(["git", "-C", str(path), "reset", "--hard", "origin/HEAD"], check=True)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["git", "clone", "--depth", "1", url, str(path)], check=True)


def rows_from_json(path: Path) -> list[dict[str, Any]]:
    data = json.loads(path.read_text(encoding="utf-8"))
    if isinstance(data, list):
        return [row for row in data if isinstance(row, dict)]
    if isinstance(data, dict):
        for key in ("data", "items", "examples", "samples", "records"):
            value = data.get(key)
            if isinstance(value, list):
                return [row for row in value if isinstance(row, dict)]
    return []


def has_problem_and_proof(row: dict[str, Any]) -> bool:
    problem = row.get("problem") or row.get("question") or row.get("statement") or row.get("original_problem")
    proof = (
        row.get("proof_solution")
        or row.get("proof")
        or row.get("solution")
        or row.get("model_solution")
        or row.get("answer")
        or row.get("response")
    )
    return isinstance(problem, str) and bool(problem.strip()) and isinstance(proof, str) and bool(proof.strip())


def write_jsonl(rows: list[dict[str, Any]], path: Path, limit: int) -> int:
    selected = rows[:limit] if limit > 0 else rows
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        for row in selected:
            handle.write(json.dumps(row, ensure_ascii=True) + "\n")
    return len(selected)


def prepare_brokenmath(limit: int) -> tuple[Path, int]:
    repo = CACHE / "broken-math"
    clone_or_update("https://github.com/insait-institute/broken-math.git", repo)
    candidates = [
        repo / "data" / "raw" / "sycophancy_recent" / "sample.json",
        repo / "data" / "raw" / "validation" / "sample.json",
        repo / "data" / "raw" / "recent_comps" / "sample.json",
    ]
    rows: list[dict[str, Any]] = []
    seen: set[str] = set()
    for candidate in candidates:
        if not candidate.exists():
            continue
        for row in rows_from_json(candidate):
            if not has_problem_and_proof(row):
                continue
            key = str(row.get("problem_id") or row.get("id") or row.get("problem"))
            if key in seen:
                continue
            seen.add(key)
            rows.append(row)
    out = DATASETS / "brokenmath.jsonl"
    return out, write_jsonl(rows, out, limit)


def prepare_opc_repo_metadata(limit: int) -> tuple[Path, int]:
    repo = CACHE / "open-proof-corpus"
    clone_or_update("https://github.com/insait-institute/open-proof-corpus.git", repo)
    source = repo / "data" / "pass_at_n.json"
    rows = rows_from_json(source) if source.exists() else []
    # This file is useful for tracking OPC problem ids and aggregate correctness,
    # but it does not contain proof bodies. Keep it separate from runnable input.
    out = DATASETS / "opc-pass-at-n.jsonl"
    return out, write_jsonl(rows, out, limit)


def correct_from_score(score: Any) -> bool | None:
    if isinstance(score, list) and score:
        values = [value for value in score if isinstance(value, int | float)]
        if values:
            return sum(1 for value in values if value > 0) >= (len(values) / 2)
    if isinstance(score, int | float):
        return score > 0
    return None


def opc_parquet_url(split: str) -> str:
    return (
        "https://huggingface.co/datasets/INSAIT-Institute/OPC/resolve/main/"
        f"data/{split}-00000-of-00001.parquet"
    )


def prepare_opc_hf(limit: int, split: str) -> tuple[Path, int]:
    ensure_parquet_reader()
    import pyarrow.parquet as pq

    parquet_path = CACHE / "opc-hf" / f"{split}.parquet"
    parquet_path.parent.mkdir(parents=True, exist_ok=True)
    if not parquet_path.exists():
        urlretrieve(opc_parquet_url(split), parquet_path)

    rows: list[dict[str, Any]] = []
    for row in pq.read_table(parquet_path).to_pylist():
        if not has_problem_and_proof(row):
            continue
        out = {
            "problem_id": row.get("problem_id"),
            "problem": row.get("problem"),
            "solution": row.get("solution"),
            "correct": correct_from_score(row.get("score")),
            "score": row.get("score"),
            "feedback": row.get("feedback"),
            "model_id": row.get("model_id"),
            "competition": row.get("competition"),
            "category": row.get("category"),
            "level": row.get("level"),
            "source": row.get("source"),
            "url": row.get("url"),
            "split": row.get("split") or split,
        }
        rows.append(out)
    out_path = DATASETS / f"opc-{split}.jsonl"
    return out_path, write_jsonl(rows, out_path, limit)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--limit", type=int, default=200, help="Max rows per prepared file; <=0 means all")
    parser.add_argument("--opc-split", choices=OPC_SPLITS, default="test")
    parser.add_argument("--clean", action="store_true", help="Remove cached repos before preparing")
    args = parser.parse_args()
    if args.clean:
        shutil.rmtree(CACHE, ignore_errors=True)

    broken_path, broken_count = prepare_brokenmath(args.limit)
    opc_path, opc_count = prepare_opc_hf(args.limit, args.opc_split)
    opc_meta_path, opc_meta_count = prepare_opc_repo_metadata(args.limit)
    print(f"brokenmath\t{broken_count}\t{broken_path}")
    print(f"opc\t{opc_count}\t{opc_path}")
    print(f"opc-pass-at-n\t{opc_meta_count}\t{opc_meta_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
